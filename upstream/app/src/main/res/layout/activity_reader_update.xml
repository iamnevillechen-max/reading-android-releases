<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <io.legado.app.ui.widget.TitleBar android:id="@+id/title_bar"
        android:layout_width="match_parent" android:layout_height="wrap_content" app:title="@string/reader_update_title" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/current_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" />
            <TextView android:id="@+id/update_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:accessibilityLiveRegion="polite" android:textSize="18sp" />
            <Button android:id="@+id/check_update" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/reader_update_check" />
            <TextView android:id="@+id/release_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="18sp" />
            <TextView android:id="@+id/release_notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="16sp" />
            <ProgressBar android:id="@+id/download_progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/progress_text" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:accessibilityLiveRegion="none" android:textSize="16sp" />
            <Button android:id="@+id/download_update" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/reader_update_download" />
            <Button android:id="@+id/cancel_update" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/reader_update_cancel" />
            <Button android:id="@+id/background_update" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/reader_update_background" android:visibility="gone" />
            <TextView android:id="@+id/permission_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reader_update_permission_info" android:textSize="16sp" />
            <Button android:id="@+id/allow_install" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/reader_update_allow_install" />
            <Button android:id="@+id/install_update" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/reader_update_install" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="@string/reader_update_preserve_data" android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

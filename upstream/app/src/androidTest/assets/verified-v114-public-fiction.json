    "header": "{\"User-Agent\": \"Mozilla/5.0\"}",
    "bookSourceComment": "2026-10-27 官方普通公开搜索JSON、详情HTML、免费目录和已公开明文正文；不调用App、登录、购买、解密接口。仅取is_vip=0目录。阅读原生搜索、详情、目录及公开正文核验通过。",
    "searchUrl": "https://www.qimao.com/qimaoapi/api/search/result?keyword={{key}}&page={{page}}",
    "ruleSearch": {
      "bookList": "$.data.search_list",
      "name": "$.title",
      "author": "$.author",
      "bookUrl": "$.book_id\n@js:'https://www.qimao.com/shuku/'+result+'/';",
      "coverUrl": "$.image_link",
      "intro": "$.intro",
      "lastChapter": "$.latest_chapter_title"
    },
    "ruleBookInfo": {
      "name": ".title .txt@text",
      "author": ".author-name a@text",
      "intro": "meta[name=description]@content",
      "tocUrl": "@js:'https://www.qimao.com/qimaoapi/api/book/chapter-list?book_id='+String(baseUrl).match(/\\/shuku\\/(\\d+)/)[1];"
    },
    "ruleToc": {
      "chapterList": "$.data.chapters[?(@.is_vip == '0')]",
      "chapterName": "$.title",
      "chapterUrl": "$.id\n@js:'https://www.qimao.com/shuku/'+String(baseUrl).match(/book_id=(\\d+)/)[1]+'-'+result+'/';"
    },
    "ruleContent": {
      "content": ".chapter-detail-article@html"
    }
  },
